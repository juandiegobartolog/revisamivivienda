Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Block direct access to internal application folders
RewriteRule ^(?:app|config|scripts|sql)(?:/|$) - [F,L,NC]

# Block hidden files except .well-known
RewriteRule "(^|/)\.(?!well-known/)" - [F,L]
</IfModule>

<FilesMatch "^(?:\.env|composer\.(?:json|lock)|README(?:\.md)?|phpunit\.xml|.*\.(?:sql|log|ini|conf|bak))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
